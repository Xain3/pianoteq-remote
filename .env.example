# Real is the default. Demo is always explicit and clearly labelled in the UI.
PTQ_MODE=real
PTQ_RPC_URL=http://127.0.0.1:8081/jsonrpc
PTQ_RPC_TIMEOUT_MS=4000
PTQ_API_HOST=127.0.0.1
PTQ_API_PORT=8787

# Set the host to 0.0.0.0 for access from your own LAN.
# For an installable PWA on a phone, put HTTPS in front of the production server.
