{
  "name": "pianoteq-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "npm run build -w @ptq/shared && concurrently --kill-others -n shared,api,web \"npm run dev -w @ptq/shared\" \"npm run dev -w @ptq/backend\" \"npm run dev -w @ptq/frontend\"",
    "dev:demo": "cross-env PTQ_MODE=demo npm run dev",
    "build": "npm run build -w @ptq/shared && npm run build -w @ptq/backend && npm run build -w @ptq/frontend",
    "typecheck": "npm run build -w @ptq/shared && npm run typecheck --workspaces --if-present",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "start": "npm run start -w @ptq/backend",
    "start:demo": "cross-env PTQ_MODE=demo npm start",
    "icons": "node scripts/generate-icons.mjs",
    "version:check": "node scripts/check-versions.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.0.0",
    "prettier": "^3.6.0",
    "semver": "^7.8.5",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
