{
  "name": "@ptq/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "vitest run --config ../../vitest.config.ts --configLoader runner"
  },
  "dependencies": {
    "@ptq/shared": "0.1.0",
    "@fastify/static": "^8.3.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
